# Active environment/user selection (overridable per-run via pytest --environment/--user)
ENVIRONMENT=test
TEST_USER=QA

# Password for the config.ini [environment.<env>.user.<username>] sections, as <USERNAME_UPPER>_PASSWORD
QA_PASSWORD=willWin

# Chrome-only (Safari has no headless mode)
HEADLESS=true

# Opt-in only, default false. If true, calls GET /reset exactly once (in the pytest-xdist controller,
# before any worker is spawned) to wipe all data at the start of the run. 
# RESET_BEFORE_RUN=true

# Default browser/resolution for UI tests, comma-separated (overridable via pytest
# --browser/--resolution). Leave unset to default to chrome,fullhd only - opt into the full matrix
# (chrome,safari x fullhd,4k) via --browser=chrome,safari --resolution=fullhd,4k.
# BROWSER=chrome
# RESOLUTION=fullhd
